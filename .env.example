# One local configuration file for Praeco: copy this template to the repository
# root `.env.local`. Do not create per-service or per-app credential files.
# Never commit actual values. Existing shell variables take precedence.
# The workspace loads this file without expanding $VAR inside values.
# A key alone does not prove connectivity or production readiness.

# Clerk Development (implemented): use a matching pk_test_ / sk_test_ pair.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon (implemented): isolated praeco_workspace conversational metadata.
# Use a confirmed development database; never the authoritative financial ledger.
DATABASE_URL=

# OpenRouter (live chat): select the model explicitly.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Trigger.dev Development (live chat worker).
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Daytona (sandbox adapter pending).
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
DAYTONA_SNAPSHOT_NAME=

# Optional LlamaParse / LlamaExtract hosted adapter.
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_PROJECT_ID=
# Pin a supported provider version before reproducibility/production claims.
LLAMA_PARSE_VERSION=latest
# Restricted local artifact state; not committed or exposed to agents.
L1_STORAGE_ROOT=.cache/praeco-l1

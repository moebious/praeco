{
  "name": "@praeco/finance-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "db:status": "node --conditions=react-server --import tsx scripts/database.mts status",
    "db:migrate": "node --conditions=react-server --import tsx scripts/database.mts migrate",
    "db:smoke": "node --conditions=react-server --import tsx scripts/database.mts smoke",
    "chat:dev": "trigger.dev dev start --config trigger.config.ts --env-file ../../.env.local --max-concurrent-runs 1 --skip-update-check --skip-telemetry",
    "chat:status": "node --conditions=react-server --import tsx scripts/chat.mts status",
    "chat:smoke": "node --conditions=react-server --import tsx scripts/chat.mts smoke",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/otel": "1.0.143",
    "@ai-sdk/react": "4.0.130",
    "@base-ui/react": "1.8.0",
    "@clerk/nextjs": "7.9.9",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@trigger.dev/sdk": "4.7.3",
    "ai": "7.0.127",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.3",
    "geist": "1.8.1",
    "lucide-react": "1.49.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/turbopack": "4.3.3",
    "@trigger.dev/build": "4.7.3",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "trigger.dev": "4.7.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }

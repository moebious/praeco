{
  "name": "praeco",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22.12.0" },
  "overrides": {
    "trigger.dev": {
      "giget": "2.0.0",
      "esbuild": "0.25.12",
      "socket.io-client": "4.8.3"
    },
    "@trigger.dev/core": { "socket.io-client": "4.8.3" },
    "engine.io-client": { "ws": "8.21.0" },
    "@prisma/config": { "deepmerge-ts": "8.0.2" },
    "@ai-sdk/provider-utils": { "undici": "6.29.0" }
  },
  "scripts": {
    "build": "npm run build --workspace @praeco/evidence-intelligence && npm run build --workspace @praeco/document-classification-adapter && npm run build --workspace @praeco/financial-decision-kernel && npm run build --workspace @praeco/financial-store-sql && npm run build --workspace @praeco/external-document-intake && npm run build --workspace @praeco/agent-harness && npm run build --workspace @praeco/finance-workspace",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:l1": "npm run test --workspace @praeco/evidence-intelligence",
    "test:l1:integration": "npm run test --workspace @praeco/external-document-intake",
    "test:l2": "npm run test --workspace @praeco/financial-decision-kernel",
    "test:l3": "npm run test --workspace @praeco/agent-harness",
    "l1:demo": "npm run demo --workspace @praeco/evidence-intelligence",
    "l1:process": "node packages/evidence-intelligence/dist/cli.js",
    "l1:evaluate": "npm run evaluate --workspace @praeco/evidence-intelligence",
    "l1:smoke": "npm run smoke --workspace @praeco/evidence-intelligence",
    "l2:demo": "npm run demo --workspace @praeco/financial-decision-kernel",
    "demo": "npm run demo --workspace @praeco/financial-decision-kernel",
    "web:workspace": "npm run dev --workspace @praeco/finance-workspace",
    "check": "npm run build && npm run typecheck && npm run lint && npm test"
  }
}
